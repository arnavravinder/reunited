{
  "rewrites": [
    {
      "source": "/scripts/env.js",
      "destination": "/api/env"
    }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cleanup-expired-claims",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "30 3 * * *"
    }
  ]
}
